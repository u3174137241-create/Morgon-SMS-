# ── AI Lead Hunter — environment configuration ──────────────────────────────
# Copy this file to .env and fill in what you have. Every value here is
# optional except where noted — the system degrades gracefully (falls back
# to a free, local, rule-based mode) when a key is missing.

# ── AI qualification (optional) ─────────────────────────────────────────────
# Without this key the system uses a free, local rule-based qualifier
# instead of calling the Anthropic API. Quality is lower but it costs 0 kr
# and the system remains fully functional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Telegram notifications (optional) ───────────────────────────────────────
# Create a bot via @BotFather on Telegram to get a token, then message the
# bot once and call https://api.telegram.org/bot<token>/getUpdates to find
# your chat id. See README.md "Telegram setup" for the full walkthrough.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Runtime ─────────────────────────────────────────────────────────────────
# When true, no real Telegram messages are sent — notifications are only
# logged to the console. Useful for testing.
DRY_RUN=false

# Local dashboard/API port
PORT=3100

# Optional password to protect the local dashboard/API (leave blank to disable)
APP_PASSWORD=

# SQLite database file location
DB_PATH=./data/leads.sqlite

# Log level: debug | info | warn | error
LOG_LEVEL=info
