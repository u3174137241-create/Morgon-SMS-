# Databas (PostgreSQL / Supabase-kompatibel)
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/slutaleta"

# Sessioner (slumpad hemlighet, minst 32 tecken)
SESSION_SECRET="change-me-to-a-long-random-string"

# Bas-URL till appen, används i verifieringslänkar och Stripe redirects
APP_BASE_URL="http://localhost:3000"

# E-post (valfritt). Utan dessa loggas verifieringslänkar till servern istället för att skickas.
RESEND_API_KEY=""
EMAIL_FROM="Sluta Leta <no-reply@slutaleta.se>"

# Stripe — krävs för riktiga betalningar. Utan dessa körs betalflödet i "ej konfigurerat"-läge.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PLUS_PRICE_ID=""

# Push-notiser till telefonen (valfritt). Utan dessa skickas bara in-app-notiser.
# Generera ett VAPID-nyckelpar, t.ex. med `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hjalp@slutaleta.se"

# Filuppladdning (valfritt). Utan dessa sparas bilder lokalt på disk (endast för utveckling).
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
