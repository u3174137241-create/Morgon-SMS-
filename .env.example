# Klientens miljövariabler (läses via app.config / expo-constants → app.json "extra")
# Lägg de riktiga värdena i app.json "extra" eller i EAS Secrets — checka aldrig in riktiga nycklar.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ---------------------------------------------------------------------------
# Serverside — sätts ENDAST som Supabase Edge Function secrets, aldrig i appen:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
